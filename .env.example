NODE_ENV=development
# SSD-Backend is the merged Auth/Users/Roles/Customers/Masters/POS/Inventory/
# Payments/Reports API (formerly User-Service + Catalog-Service +
# Payment-Service + Notification-Service, four separate processes/ports).
# One port for the whole thing now.
PORT=5003
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5001

MONGO_URI=mongodb://127.0.0.1:27017/ssd-temple

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_COST=12

ACTIVATION_TOKEN_TTL_HOURS=48
RESET_TOKEN_TTL_MINUTES=30
MOBILE_OTP_TTL_MINUTES=5

ADMIN_APP_URL=http://localhost:5001

# --- Notifications --------------------------------------------------------
# Keep this true until the real SSD temple SES identity + SMS sender are
# provisioned. While true, nothing below is actually called — every email
# is logged to the console and to logs/dry-run-emails.log instead, so the
# activation/forgot-password flow can be tested safely with placeholder keys.
DRY_RUN_NOTIFICATIONS=true

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
SENDER_EMAIL_ID=no-reply@example-temple.org

# Reserved for the mobile-change OTP flow (not wired up yet)
SMS_SENDER_ID=SSDTEMPLE

# --- Seed script ------------------------------------------------------------
DEFAULT_ENTITY_CODE=SST
SEED_SUPER_ADMIN_NAME=Temple Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example-temple.org
